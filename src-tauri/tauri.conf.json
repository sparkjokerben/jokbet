{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "jokerben-desktop-pet",
  "version": "../package.json",
  "identifier": "io.github.sparkjokerben.jokerben-desktop-pet",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "license": "GPL-3.0-only",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVDQ0QwRUYxNEY3OEE4MjYKUldRbXFIaFA4UTdON1BsNGM2OG9NaWtuRWJ0NmVHWFNLc3dXL2xORUhEemlOaHlpUjNBN0FrRlIK",
      "endpoints": [
        "https://github.com/sparkjokerben/jokerben-desktop-pet/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
