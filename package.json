{
  "name": "jokerben-desktop-pet",
  "version": "0.0.1",
  "description": "A lightweight desktop pet that counts your keyboard and mouse activity",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-only",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "tauri": "tauri",
    "icons": "node scripts/render-sprites.ts icons src-tauri/icons/source && tauri icon src-tauri/icons/source/icon-source.png && rm -rf src-tauri/icons/android src-tauri/icons/ios",
    "sprites": "node scripts/render-sprites.ts sheet sprites.png"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tauri-apps/cli": "^2.11.5",
    "@types/node": "^26.6.2",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
